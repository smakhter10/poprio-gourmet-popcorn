{
  "name": "poprio-gourmet-popcorn",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && node scripts/copy-build-to-theme.js",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "package:theme": "npm run build && python scripts/package-theme.py",
    "package:plugin": "python scripts/package-plugin.py",
    "package:all": "npm run build && python scripts/package-all.py",
    "test:render": "php scripts/verify-render.php",
    "test:phase3": "php scripts/test-phase-3.php",
    "test:phase5": "php scripts/test-phase-5.php",
    "test": "npm run typecheck && npm run test:render && npm run test:phase3 && npm run test:phase5"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "clsx": "^2.1.1",
    "gsap": "^3.12.5",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.1",
    "tailwindcss": "^4.0.0",
    "vite": "^6.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.7.2"
  }
}
